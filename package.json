{
  "name": "orbit3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Scroll-driven WebGL site runtime plus a scene editor. Original work — see README.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.tmp/smoke.mjs --log-level=warning && node .tmp/smoke.mjs",
    "export": "node scripts/export.mjs"
  },
  "dependencies": {
    "three": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "latest",
    "esbuild": "^0.28.2",
    "typescript": "latest",
    "vite": "latest"
  }
}
